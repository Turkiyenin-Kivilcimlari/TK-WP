# Application Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost
NEXTAUTH_URL=http://localhost
NEXTAUTH_SECRET=production-nextauth-secret-key-here

# Database Configuration
MONGODB_URI=mongodb://mongodb:27017/topluluk_prod
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=production_password_123
MONGO_DATABASE=topluluk_prod
MONGO_APP_USERNAME=topluluk_user
MONGO_APP_PASSWORD=production_secure_password_123

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=production_redis_123

# JWT Configuration
JWT_SECRET=production-jwt-secret-key-here
JWT_EXPIRE=7d

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_EMAIL=your-email@gmail.com
MAIL_PASSWORD=your-app-password
SECURE_CONNECTITON_TYPE=TLS

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Cloudflare Configuration
NEXT_PUBLIC_CLOUDFLARE_SITE_KEY=your-site-key
CLOUDFLARE_WIDGET_SECRET_KEY=your-secret-key

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Production specific
NEXT_TELEMETRY_DISABLED=1